{#
  §12 — the standalone bug report.

  Seven sections in the order §12 lists them. Everything is inline: no CDN, no
  fetch, no web fonts. The only script is the copy button at the bottom; the
  collapsible parts are `<details>`, which needs none.

  Light ground rather than the application's dark one (§11.2). This file is
  attached to a ticket and printed into it; the palette's *meaning* is kept —
  amber is causality and nothing else — but a dark page is the wrong medium for
  a document. The waveform inherits the same rule via `currentColor`.
#}<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>VeriTrace — {{ title }}</title>
<style>
  :root {
    --causal: #b5761a; --causal-bg: #fdf4e5;
    --line: #d9dee5; --text: #2b3138; --dim: #6b7785; --bg: #ffffff;
    --raised: #f6f8fa; --bad: #c0392b; --ok: #1e7a4d;
    --mono: ui-monospace, "SFMono-Regular", "JetBrains Mono", Menlo, monospace;
    --sans: "IBM Plex Sans", system-ui, -apple-system, sans-serif;
  }
  * { box-sizing: border-box; }
  body { margin: 0; padding: 0 0 4rem; background: var(--bg); color: var(--text);
         font: 14px/1.5 var(--sans); }
  main { max-width: 60rem; margin: 0 auto; padding: 0 1.25rem; }
  header { border-bottom: 2px solid var(--causal); padding: 1.5rem 1.25rem 1rem;
           max-width: 60rem; margin: 0 auto; }
  h1 { font-size: 1.5rem; margin: 0 0 .25rem; letter-spacing: -.01em; }
  h2 { font-size: .8rem; text-transform: uppercase; letter-spacing: .08em;
       color: var(--dim); margin: 2.25rem 0 .75rem; font-weight: 600; }
  .meta { display: grid; grid-template-columns: auto 1fr; gap: .1rem 1rem;
          font: 12px/1.5 var(--mono); color: var(--dim); margin-top: .75rem; }
  .meta b { font-weight: 500; color: var(--dim); }
  .meta span { color: var(--text); overflow-wrap: anywhere; }
  .lede { font-size: 1.05rem; line-height: 1.55; margin: 0; }
  code, pre, .mono { font-family: var(--mono); font-size: 12px; }
  pre { background: var(--raised); border: 1px solid var(--line); border-radius: 3px;
        padding: .6rem .75rem; overflow-x: auto; margin: 0; }

  /* Section 3 — the spine. One card per step, amber rail down the left. */
  .step { border: 1px solid var(--line); border-left: 3px solid var(--causal);
          border-radius: 3px; padding: .6rem .75rem; margin: 0 0 .5rem; }
  .step-top { display: flex; gap: .5rem; align-items: baseline; flex-wrap: wrap; }
  .step-sig { font-family: var(--mono); font-weight: 600; }
  .step-val { font-family: var(--mono); color: var(--causal); }
  .step-at { margin-left: auto; font-family: var(--mono); color: var(--dim); }
  .step-why { margin: .3rem 0 0; }
  .step-loc { font-family: var(--mono); font-size: 11px; color: var(--dim); }
  .snip { margin: .5rem 0 0; }
  .snip .ln { color: var(--dim); user-select: none; display: inline-block;
              width: 3.5em; text-align: right; padding-right: 1em; }
  .snip .hit { background: var(--causal-bg); display: block; }
  details { margin: .4rem 0 0; }
  summary { cursor: pointer; color: var(--dim); font-size: 12px; }

  /* Section 4 — the subtrace, as a timeline. */
  table { border-collapse: collapse; width: 100%; font-size: 13px; }
  th, td { text-align: left; padding: .35rem .5rem; border-bottom: 1px solid var(--line);
           vertical-align: top; }
  th { font-size: 11px; text-transform: uppercase; letter-spacing: .06em; color: var(--dim); }
  td.t, td.v { font-family: var(--mono); white-space: nowrap; }
  tr.root td { background: var(--causal-bg); }

  /* Section 5 — the waveform. */
  svg.wave { border: 1px solid var(--line); border-radius: 3px; background: var(--bg);
             display: block; }
  .wave .sig { fill: none; stroke: var(--text); stroke-width: 1.4; }
  .wave .bus { fill: var(--raised); stroke: var(--text); stroke-width: .8; }
  .wave .busv, .wave .lbl, .wave .axis, .wave .busy-t {
    font-family: var(--mono); font-size: 10px; fill: var(--text); }
  .wave .lbl { fill: var(--dim); }
  .wave .mark { stroke: var(--causal); stroke-width: 1; stroke-dasharray: 2 3; }
  .wave .busy { fill: var(--raised); stroke: var(--line); }

  .note { color: var(--dim); font-size: 12px; margin: .4rem 0 0; }
  .verdict { display: inline-block; padding: .1rem .45rem; border-radius: 3px;
             font: 600 11px/1.6 var(--mono); }
  .verdict.ok { background: #e6f4ec; color: var(--ok); }
  .verdict.no { background: #fbeceb; color: var(--bad); }
  .bar { display: flex; align-items: center; gap: .6rem; margin: 0 0 .5rem; }
  button { font: 11px var(--sans); padding: .25rem .6rem; border: 1px solid var(--line);
           background: var(--raised); border-radius: 3px; cursor: pointer; color: var(--text); }
  footer { max-width: 60rem; margin: 3rem auto 0; padding: 1rem 1.25rem 0;
           border-top: 1px solid var(--line); color: var(--dim); font-size: 12px; }
  @media print {
    details { display: block; } details > summary { display: none; }
    button { display: none; } .step { break-inside: avoid; }
  }
</style>
</head>
<body>

{# 1 — header #}
<header>
  <h1>{{ title }}</h1>
  <p class="lede">{{ symptom }}</p>
  <div class="meta">
    <b>design</b><span>{{ top }}</span>
    <b>trace</b><span>{{ trace }}</span>
    {% if query %}<b>question</b><span>{{ query }}</span>{% endif %}
    {% if command %}<b>simulated with</b><span>{{ command }}</span>{% endif %}
    {% if rtl_sha256 %}<b>rtl sha256</b><span>{{ rtl_sha256 }}</span>{% endif %}
    <b>veritrace</b><span>{{ version }} · {{ generated }}</span>
  </div>
</header>

<main>

{# 3 — the causal chain #}
<h2>Causal chain</h2>
{% for s in steps %}
<div class="step">
  <div class="step-top">
    <span class="step-sig">{{ s.signal }}</span>
    <span class="step-val">= {{ s.value }}</span>
    <span class="step-at">{% if s.cycle is not none %}c{{ s.cycle }}{% else %}t={{ s.time }}{% endif %}</span>
  </div>
  {% if s.detail %}<div class="step-loc">{{ s.detail }}</div>{% endif %}
  {% if s.loc %}<div class="step-loc">{{ s.loc }}</div>{% endif %}
  {% if s.snippet %}
  <pre class="snip">{% for n, text, hit in s.snippet.lines %}<span class="{{ 'hit' if hit else '' }}"><span class="ln">{{ n }}</span>{{ text }}</span>
{% endfor %}</pre>
  {% endif %}
  {% if s.alternatives %}
  <details>
    <summary>{{ s.alternatives|length }} alternative branch{{ '' if s.alternatives|length == 1 else 'es' }} the ordering ranked lower</summary>
    <pre>{% for a in s.alternatives %}{{ a }}
{% endfor %}</pre>
  </details>
  {% endif %}
</div>
{% else %}
<p class="note">The chain is empty.</p>
{% endfor %}

{# 4 — minimal subtrace #}
<h2>Minimal subtrace</h2>
<p class="note">
  {{ subtrace.considered }} event{{ '' if subtrace.considered == 1 else 's' }} on the chain,
  {{ subtrace.dropped }} removed as redundant, {{ events|length }} left.
  {% if not subtrace.reached_root_cause %}
  The walk did not reach a terminal that explains the value, so the last line is
  where it stopped rather than the cause.
  {% endif %}
  {% if subtrace.delta_skipped %}
  The minimality check was skipped: too many events for it to be quick.
  {% endif %}
</p>
<table>
  <thead><tr><th>when</th><th>signal</th><th>value</th><th>what happened</th></tr></thead>
  <tbody>
  {% for e in events %}
    <tr class="{{ 'root' if e.is_root_cause else '' }}">
      <td class="t">{% if e.cycle is not none %}c{{ e.cycle }}{% else %}{{ e.time }}{% endif %}</td>
      <td class="t">{{ e.signal }}</td>
      <td class="v">{{ e.value }}</td>
      <td>{{ e.text }}{% if e.loc %} <span class="step-loc">{{ e.loc.file }}:{{ e.loc.line }}</span>{% endif %}</td>
    </tr>
  {% endfor %}
  </tbody>
</table>

{# 5 — waveform, inline SVG #}
{% if svg %}
<h2>Waveform</h2>
{# The one deliberate `safe` on the page. `report._svg` builds this markup and
   escapes every value that came from the trace; escaping it again here would
   print the SVG source instead of drawing it. #}
{{ svg | safe }}
<p class="note">Only the signals on the chain, only the window that explains it.
  Dashed amber marks a subtrace event.</p>
{% endif %}

{# 6 — the repro #}
{% if repro %}
<h2>{{ 'Minimal repro' if repro.mode == 'minimal' else 'Focused testbench' }}</h2>
<p class="note">{{ repro.mode_reason }}</p>
<div class="bar">
  {% if repro.validation.ran %}
    {% if repro.validation.reproduced %}
      <span class="verdict ok">reproduces</span>
      <span class="note">verified with {{ repro.validation.tool }} in
        {{ repro.validation.seconds }}s — {{ repro.cycles }} cycles instead of the original run</span>
    {% else %}
      <span class="verdict no">does not reproduce</span>
      <span class="note">{{ repro.validation.error }}</span>
    {% endif %}
  {% else %}
    <span class="verdict no">not validated</span>
    <span class="note">{{ repro.validation.error or 'no simulator was run' }}</span>
  {% endif %}
  <button id="copy" data-for="repro-code">copy</button>
</div>
{% for n in repro.notes %}<p class="note">{{ n }}</p>{% endfor %}
<pre id="repro-code">{{ repro.code }}</pre>
{% endif %}

{# 7 — appendix #}
{% if nearby or annotations %}
<h2>Appendix</h2>
{% if nearby %}
<table>
  <thead><tr><th>check</th><th>signal</th><th>where</th><th>what</th></tr></thead>
  <tbody>
  {% for f in nearby %}
    <tr>
      <td class="t">{{ f.check }}</td>
      <td class="t">{{ f.signal or '' }}</td>
      <td class="t">{% if f.loc %}{{ f.loc.file }}:{{ f.loc.line }}{% endif %}</td>
      <td>{{ f.title }}{% if f.detail %} — {{ f.detail }}{% endif %}</td>
    </tr>
  {% endfor %}
  </tbody>
</table>
<p class="note">Automatic findings on or beside the chain. Everything else this
  run found is in the Checks tab, not here.</p>
{% endif %}
{% for a in annotations %}<p>{{ a }}</p>{% endfor %}
{% endif %}

</main>

<footer>
  Generated by VeriTrace {{ version }}. This file is self-contained: no network,
  no external assets.
</footer>

<script>
// The whole of §12's allowance for script. Everything collapsible above is a
// native <details>.
document.getElementById("copy")?.addEventListener("click", function (e) {
  var btn = e.currentTarget;
  var src = document.getElementById(btn.dataset.for);
  if (!src) return;
  var done = function () { btn.textContent = "copied"; setTimeout(function () { btn.textContent = "copy"; }, 1200); };
  if (navigator.clipboard) { navigator.clipboard.writeText(src.textContent).then(done, function () {}); return; }
  var r = document.createRange(); r.selectNodeContents(src);
  var s = window.getSelection(); s.removeAllRanges(); s.addRange(r);
  try { document.execCommand("copy"); done(); } catch (err) {}
  s.removeAllRanges();
});
</script>
</body>
</html>
